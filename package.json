{
  "name": "brick-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "acquire": "tsx scripts/acquire-model.ts",
    "assets:build": "tsx scripts/build-assets.ts",
    "assets:validate": "tsx scripts/validate-assets.ts",
    "assets:reference": "tsx scripts/verify-reference.ts",
    "assets:repro": "tsx scripts/check-reproducible.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run assets:validate && npm run assets:reference && npm test && npm run build",
    "start:local": "node scripts/start-local.mjs",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.55.1",
    "@types/yauzl": "^2.10.3",
    "@types/node": "22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "yauzl": "3.4.0",
    "pngjs": "^7.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
