{
  "name": "@brick-atlas/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs server.ts",
    "start": "node launch.mjs",
    "test": "node ../node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "check": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "build": "node ../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "pilot": "node ../node_modules/tsx/dist/cli.mjs run.ts",
    "diagnostics": "node ../node_modules/tsx/dist/cli.mjs diagnostics.ts",
    "report": "node ../node_modules/tsx/dist/cli.mjs report.ts",
    "test:ui": "node ../node_modules/tsx/dist/cli.mjs tests/ui.ts",
    "test:replay": "node ../node_modules/tsx/dist/cli.mjs tests/replay.ts",
    "suite:start": "node suite/launch.mjs",
    "suite:dev": "node ../node_modules/tsx/dist/cli.mjs suite/server.ts",
    "suite:prepare": "node ../node_modules/tsx/dist/cli.mjs suite/cli.ts prepare",
    "suite:run": "node ../node_modules/tsx/dist/cli.mjs suite/cli.ts run",
    "suite:replay": "node ../node_modules/tsx/dist/cli.mjs suite/cli.ts replay",
    "suite:export": "node ../node_modules/tsx/dist/cli.mjs suite/cli.ts export-inputs",
    "suite:score": "node ../node_modules/tsx/dist/cli.mjs suite/cli.ts score",
    "suite:build": "node ../node_modules/vite/bin/vite.js build --config suite/vite.config.ts",
    "suite:ui": "node ../node_modules/tsx/dist/cli.mjs suite/ui-test.ts",
    "suite:integration": "node ../node_modules/tsx/dist/cli.mjs suite/integration-test.ts"
  }
}
