    "ldraw:score": "node ../../../node_modules/tsx/dist/cli.mjs score.ts",
    "ldraw:analyze": "python3 analyze.py",
    "ldraw:experiments": "node ../../../node_modules/tsx/dist/cli.mjs experiments.ts",
    "ldraw:run": "node ../../../node_modules/tsx/dist/cli.mjs run-model.ts",
    "ldraw:legacy": "node ../../../node_modules/tsx/dist/cli.mjs legacy-replay.ts",
    "ldraw:render": "node ../../../node_modules/tsx/dist/cli.mjs capture-inputs.ts",
    "ldraw:verify-experiments": "node ../../../node_modules/tsx/dist/cli.mjs verify-experiments.ts",
    "ldraw:verify-ui": "node ../../../node_modules/tsx/dist/cli.mjs verify-ui.ts",
    "ldraw:paper": "python3 publication.py",
    "ldraw:verify-paper": "python3 verify-publication.py",
    "ldraw:serve": "python3 serve.py",
    "check": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.json"
